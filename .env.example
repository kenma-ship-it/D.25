# Copy this file to .env and fill in real values. .env is only ever read by
# the server (server/index.js and friends) — nothing in public/ can see it,
# so secrets pasted here never reach the customer's browser.

PORT=3000

# ---------------------------------------------------------------------------
# Delivery — Borzo integration (see server/delivery/README-style comments in
# server/delivery/index.js for the full explanation)
# ---------------------------------------------------------------------------
# Leave this false until DE.25 has approved going live AND Borzo onboarding
# is complete. While false (or unset), the DemoDeliveryProvider is used and
# every delivery quote/status in the UI is clearly labelled as a demo
# estimate — no real courier is ever contacted.
BORZO_DELIVERY_ENABLED=false

# Only needed once BORZO_DELIVERY_ENABLED=true. Get these from Borzo's
# business dashboard after onboarding.
BORZO_API_KEY=
BORZO_API_SECRET=
BORZO_API_URL=https://robot-in.borzodelivery.com/api/business/1.4

# The pickup point Borzo prices every delivery from — set this to Harshali's
# real kitchen address/phone before ever enabling live delivery.
PICKUP_ADDRESS=
PICKUP_PHONE=

# ---------------------------------------------------------------------------
# Admin API + Owner Dashboard (see server/routes/admin.js, public/admin/)
# ---------------------------------------------------------------------------
# Leave blank to disable the admin API AND the owner dashboard entirely
# (every /api/admin/* route 404s, and the dashboard shows an "isn't enabled"
# message instead of a login screen). Set a long random value to enable it.
# Open http://localhost:3000/admin/ and enter this same value to unlock the
# live orders dashboard — it's sent as "Authorization: Bearer <this value>"
# on every admin request. This is a stand-in for real admin authentication —
# see the comment at the top of server/middleware/adminAuth.js before
# relying on this in production.
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Order notifications — WhatsApp (see server/notifications/)
# ---------------------------------------------------------------------------
# Leave WHATSAPP_NOTIFICATIONS_ENABLED false (or unset) to stay in demo mode:
# every "new order" alert to the owner and every order-slip message to the
# customer is logged to the server console and to data/notifications.json
# (visible in the owner dashboard's Notifications panel) instead of actually
# being sent. No WhatsApp account or credentials are required to demo the
# full order flow. Nothing about this ever fakes a delivery-partner name,
# phone number, or tracking link — see server/notifications/messages.js.
WHATSAPP_NOTIFICATIONS_ENABLED=false

# The phone number that should receive a WhatsApp alert for every new order
# (DE.25's own number, in international format without a leading + or 0,
# e.g. 91XXXXXXXXXX). Used by both the demo and live providers.
OWNER_WHATSAPP_NUMBER=

# The shop's own contact number, shown to the customer inside their order
# slip message ("Questions about your order? Call DE.25 at ..."). Optional —
# the line is simply omitted if left blank.
SHOP_CONTACT_PHONE=

# Only needed once WHATSAPP_NOTIFICATIONS_ENABLED=true. Get these from
# Meta's WhatsApp Business Platform (business.facebook.com) after DE.25 sets
# up a WhatsApp Business account and verifies a phone number there. IMPORTANT:
# WhatsApp's policy requires business-initiated messages like these to use a
# pre-approved message TEMPLATE, not free-form text — see the detailed
# comments at the top of server/notifications/WhatsAppCloudProvider.js
# before going live. Many businesses in India go through a reseller
# (Interakt, AiSensy, Gupshup, etc.) instead of Meta directly; if so, adapt
# _request()/_sendTemplate() in that file to your reseller's API shape.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_TEMPLATE_NAME=de25_order_notification
WHATSAPP_TEMPLATE_LANG=en

# Approved AUTHENTICATION-category template (with a "Copy code" button) used
# for the 6-digit verification codes (My Orders + checkout).
WHATSAPP_OTP_TEMPLATE_NAME=de25_verification_code

# Signs the 30-minute "number verified" tokens. Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random one is used per server start (customers re-verify after restarts).
PHONE_VERIFICATION_SECRET=

# Set to "production" on the live server. Outside production, with no WhatsApp
# account connected, codes are shown on screen for testing — never in production.
NODE_ENV=

# ---------------------------------------------------------------------------
# Product catalog — Google Sheets (see server/products/GoogleSheetsProductsProvider.js)
# ---------------------------------------------------------------------------
# Leave false (default) to keep the menu in data/products.json, edited by
# hand or through the admin API. Set true to let the owner edit the menu in
# a Google Sheet instead — no code changes or redeploy needed to update a
# price or mark something sold out. See README.txt's "PRODUCT CATALOG:
# JSON FILE NOW, GOOGLE SHEETS READY LATER" section for the full setup walk-
# through, and data/products-sheet-template.csv for the exact columns to
# use (pre-filled with the current menu — import it as your Products tab).
GOOGLE_SHEETS_PRODUCTS_ENABLED=false

# The spreadsheet's ID (the long value in its URL between /d/ and /edit).
GOOGLE_SHEETS_ID=

# A Google Cloud service account's credentials — create one, enable the
# Sheets API for its project, generate a JSON key, and share the target
# sheet with this email (Editor access if the admin dashboard should be
# able to write price/availability edits back to the sheet, Viewer if it
# should only ever be read from). Paste the private key with its literal
# newlines intact (or "\n" escapes — both are handled).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Only change these if your sheet uses different tab/range names than the
# template (data/products-sheet-template.csv assumes a "Products" tab).
GOOGLE_SHEETS_PRODUCTS_RANGE=Products!A1:Z1000
GOOGLE_SHEETS_CATEGORIES_RANGE=Categories!A1:C1000

# How often (milliseconds) to re-fetch the sheet in the background. The
# menu doesn't change fast enough to need this lower than a minute or so;
# the owner dashboard also has a manual "Refresh menu" action that doesn't
# wait for this timer (POST /api/admin/products/refresh).
GOOGLE_SHEETS_REFRESH_MS=300000

# ---------------------------------------------------------------------------
# Admin login — Supabase Auth (see server/lib/adminAuthConfig.js)
# ---------------------------------------------------------------------------
# Leave unset to keep the single-shared-secret ADMIN_TOKEN login above.
# Set to "supabase" to give the owner (and anyone else who needs it) a real
# email/password login instead, with its own session that expires and can
# be revoked — recommended once more than one person needs dashboard
# access. Requires the three SUPABASE_* values below to ALSO be set, or
# this silently falls back to ADMIN_TOKEN with a warning in the server log.
ADMIN_AUTH_PROVIDER=

# ---------------------------------------------------------------------------
# Supabase (see server/lib/supabaseRest.js, server/orders/SupabaseOrdersStore.js,
# server/lib/supabaseAuth.js) — one Supabase project can back BOTH admin
# login and order storage below; you only need to create it once.
# ---------------------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=
# The public "anon" key — safe to expose to the browser (used by the admin
# dashboard's login page itself); Row Level Security is what actually
# protects data, not this key's secrecy. Needed for ADMIN_AUTH_PROVIDER=supabase.
SUPABASE_ANON_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret. Used ONLY
# server-side to verify a dashboard login's token. Needed for
# ADMIN_AUTH_PROVIDER=supabase.
SUPABASE_JWT_SECRET=

# Comma-separated emails allowed into the owner dashboard when
# ADMIN_AUTH_PROVIDER=supabase. A valid Supabase login alone is NOT enough —
# new Supabase projects let anyone sign up by default, so without this list
# any stranger could create an account and see every customer's orders.
# Empty = nobody gets in (fails closed). Also turn off "Allow new users to
# sign up" in Supabase -> Authentication -> Providers -> Email.
ADMIN_EMAILS=

# Number of reverse-proxy hops in front of this server (e.g. 1 behind a
# single nginx / Render / Railway router). Leave empty when clients connect
# directly — otherwise anyone can fake their IP with an X-Forwarded-For
# header and walk straight past every rate limit.
TRUST_PROXY=
# The "service_role" secret key. NEVER expose this to a browser — it
# bypasses Row Level Security entirely. Needed for SUPABASE_ORDERS_ENABLED=true.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Order storage — Supabase Postgres (see server/orders/SupabaseOrdersStore.js)
# ---------------------------------------------------------------------------
# Leave false (default) to keep orders in data/orders.json. Set true to
# store them in a real Postgres database instead — recommended once order
# volume grows past what a single JSON file comfortably handles, or once
# you're deploying somewhere that doesn't keep a persistent local disk
# between deploys. Run supabase/schema.sql in your Supabase project's SQL
# editor once before turning this on. Requires SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY above.
SUPABASE_ORDERS_ENABLED=false

# ---------------------------------------------------------------------------
# QR REVIEW PAGE (/review) — customers scan the counter QR, rate, get an
# AI-drafted review and post it on Google. Print the QR card at /review/card.html
# ---------------------------------------------------------------------------
# Public address of this website, e.g. https://de25.in — the printed QR
# encodes <this>/review/. If empty, the address the site is visited on is used.
PUBLIC_SITE_URL=
# Where "Copy & post on Google" sends people. Paste the review link from your
# Google Business Profile (Home -> "Ask for reviews" -> copy link, looks like
# https://g.page/r/XXXXXXXX/review). Must be a Google link; anything else is ignored.
GOOGLE_REVIEW_URL=
# Alternative to the link above: your Google Place ID (starts with "ChIJ").
GOOGLE_PLACE_ID=
# Grok (xAI) writes the suggested review — server-side only, never sent to
# the browser. Without a key a free built-in writer is used (also the
# automatic backup if Grok is down). Get a key at https://console.x.ai
XAI_API_KEY=
# Optional: model override (default grok-4.7) and API base URL.
XAI_MODEL=
XAI_BASE_URL=

# ---------------------------------------------------------------------------
# ONLINE PAYMENTS — demo until a gateway is configured (no money moves in demo)
# ---------------------------------------------------------------------------
# Set to razorpay once your Razorpay account is activated. Without both keys
# below the site stays on demo payments.
PAYMENTS_PROVIDER=demo
# Razorpay Dashboard -> Account & Settings -> API Keys. The key id is public;
# the key secret must stay server-side (never commit it, never share it).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Account & Settings -> Webhooks -> Add new webhook:
#   URL: https://<your-domain>/api/payments/webhook
#   Events: payment.authorized, payment.captured, payment.failed, order.paid,
#           refund.processed, refund.failed
#   Secret: any long random string — paste the same value here.
RAZORPAY_WEBHOOK_SECRET=
# Minutes an order waits for payment before it is cancelled (default 30).
PAYMENT_WINDOW_MINUTES=30
